<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_students" model="ir.module.category">
            <field name="name">Students Management</field>
            <field name="description">Helps you manage student data and exams.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_student_viewer" model="res.groups">
            <field name="name">Viewer</field>
            <field name="category_id" ref="module_category_students"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
            <field name="comment">Hak baca data akademik siswa tanpa akses operasional.</field>
        </record>

        <record id="group_student_trainer" model="res.groups">
            <field name="name">Trainer</field>
            <field name="category_id" ref="module_category_students"/>
            <field name="implied_ids" eval="[(6, 0, [ref('group_student_viewer')])]"/>
            <field name="comment">Hak operasional ujian, penilaian, rapot, dan portofolio siswa.</field>
        </record>

        <record id="group_student_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_students"/>
            <field name="implied_ids" eval="[(6, 0, [ref('group_student_trainer')])]"/>
            <field name="comment">Hak penuh untuk master siswa, enrollment, dan konfigurasi.</field>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
