<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form View for SiswaKursusPenilaianSertifikat -->
        <record id="view_siswa_kursus_penilaian_sertifikat_form" model="ir.ui.view">
            <field name="name">siswa.kursus.penilaian.sertifikat.form</field>
            <field name="model">siswa.kursus.penilaian.sertifikat</field>
            <field name="arch" type="xml">
                <form string="Penilaian Sertifikat Kursus">
                    <header>
                        <button name="action_set_done" type="object" string="Selesai Penilaian"
                                class="oe_highlight"
                                invisible="state == 'done'"
                                confirm="Apakah Anda yakin ingin menyelesaikan penilaian ini? Status enrollment siswa akan diperbarui menjadi 'Lulus'."/>
                        <button name="%(students.action_report_rapot_siswa)d" type="action" string="Cetak Rapot"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" icon="fa-calculator">
                                <field name="average_score" widget="statinfo" string="Rata-rata Skor" readonly="1"/>
                            </button>
                        </div>
                        <div class="alert alert-info" role="alert" invisible="state == 'done'">
                            <strong>Penilaian masih Draft</strong><br/>
                            Urutan kerja: periksa nilai materi, lengkapi rubrik dan catatan, lalu klik <em>Selesai Penilaian</em>. Tombol tersebut menjalankan proses kelulusan yang sudah berlaku.
                        </div>
                        <div class="alert alert-success" role="alert" invisible="state != 'done'">
                            <strong>Penilaian selesai · Rapot siap dicetak</strong><br/>
                            Data nilai telah dikunci. Gunakan tombol Cetak Rapot untuk membuat dokumen PDF.
                        </div>
                        <group>
                            <group string="Identitas Program">
                                <field name="display_name" readonly="1"/>
                                <field name="enrollment_id" readonly="1"/>
                                <field name="siswa_id" readonly="1"/>
                                <field name="modul_id" readonly="1"/>
                                <field name="pelatih_id"/>
                            </group>
                            <group string="Ringkasan Nilai">
                                <field name="total_score" readonly="1"/>
                                <field name="average_score" readonly="1"/>
                                <field name="rubrik_total" readonly="1"/>
                                <field name="nilai_huruf" readonly="1"/>
                                <field name="semester" readonly="state == 'done'"/>
                                <field name="tahun_ajaran" placeholder="2025/2026" readonly="state == 'done'"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="1. Nilai Materi">
                                <field name="assessment_line_ids" readonly="state == 'done'">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="penilaian_item_id" readonly="1"/>
                                        <field name="name" invisible="1"/>
                                        <field name="description" invisible="1"/>
                                        <field name="score"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="2. Rubrik Umum">
                                <button name="action_load_rubrik" type="object" string="Muat Aspek dari Master"
                                        class="btn-secondary mb-2" invisible="state == 'done'"/>
                                <field name="rubrik_line_ids" readonly="state == 'done'">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="aspek_id" invisible="1"/>
                                        <field name="name"/>
                                        <field name="max_score"/>
                                        <field name="score"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="3. Catatan Rapot">
                                <field name="catatan" placeholder="Catatan dan masukan untuk siswa..." readonly="state == 'done'"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_siswa_kursus_penilaian_sertifikat_kanban" model="ir.ui.view">
            <field name="name">siswa.kursus.penilaian.sertifikat.kanban.flow</field>
            <field name="model">siswa.kursus.penilaian.sertifikat</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="display_name"/>
                    <field name="siswa_id"/>
                    <field name="modul_id"/>
                    <field name="average_score"/>
                    <field name="nilai_huruf"/>
                    <field name="semester"/>
                    <field name="tahun_ajaran"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_record">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <strong class="o_kanban_record_title"><field name="siswa_id"/></strong>
                                    <span t-if="record.state.raw_value == 'draft'" class="badge rounded-pill text-bg-warning">Perlu Dilengkapi</span>
                                    <span t-if="record.state.raw_value == 'done'" class="badge rounded-pill text-bg-success">Siap Dicetak</span>
                                </div>
                                <div class="text-muted"><i class="fa fa-book me-1"/><field name="modul_id"/></div>
                                <div class="d-flex justify-content-between border-top pt-2 mt-2">
                                    <span>Rata-rata</span>
                                    <strong><field name="average_score"/></strong>
                                </div>
                                <div class="d-flex justify-content-between mt-1">
                                    <span>Nilai akhir</span>
                                    <strong><field name="nilai_huruf"/></strong>
                                </div>
                                <div class="text-muted small mt-2">
                                    <field name="semester"/> <field name="tahun_ajaran"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_siswa_kursus_penilaian_sertifikat_search_flow" model="ir.ui.view">
            <field name="name">siswa.kursus.penilaian.sertifikat.search.flow</field>
            <field name="model">siswa.kursus.penilaian.sertifikat</field>
            <field name="arch" type="xml">
                <search string="Cari Finalisasi Rapot">
                    <field name="siswa_id"/>
                    <field name="modul_id"/>
                    <field name="tahun_ajaran"/>
                    <separator/>
                    <filter name="filter_draft" string="Perlu Dilengkapi" domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_done" string="Siap Dicetak" domain="[('state', '=', 'done')]"/>
                    <group expand="0" string="Kelompokkan">
                        <filter name="group_state" string="Tahap" context="{'group_by': 'state'}"/>
                        <filter name="group_modul" string="Kursus/Modul" context="{'group_by': 'modul_id'}"/>
                        <filter name="group_siswa" string="Siswa" context="{'group_by': 'siswa_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Tree View for SiswaKursusPenilaianSertifikat -->
        <record id="view_siswa_kursus_penilaian_sertifikat_tree" model="ir.ui.view">
            <field name="name">siswa.kursus.penilaian.sertifikat.tree</field>
            <field name="model">siswa.kursus.penilaian.sertifikat</field>
            <field name="arch" type="xml">
                <tree string="Penilaian Sertifikat Kursus">
                    <field name="display_name"/>
                    <field name="siswa_id"/>
                    <field name="modul_id"/>
                    <field name="average_score"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Action for SiswaKursusPenilaianSertifikat -->
        <record id="action_siswa_kursus_penilaian_sertifikat" model="ir.actions.act_window">
            <field name="name">Finalisasi Rapot Siswa</field>
            <field name="res_model">siswa.kursus.penilaian.sertifikat</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_siswa_kursus_penilaian_sertifikat_search_flow"/>
            <field name="context">{'search_default_group_state': 1}</field>
        </record>

    </data>
</odoo>
